{
  "name": "ytmon-desktop",
  "productName": "YTMon Desktop",
  "version": "0.1.0",
  "description": "Desktop client for the Termux YouTube Monitor (FastAPI server on Android)",
  "private": true,
  "main": "dist/main/main.cjs",
  "author": {
    "name": "YTMon Desktop contributors",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "icon": "electron scripts/make-icon.mjs --no-sandbox",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "postinstall": "node scripts/build-main.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run smoke",
    "check-server": "node scripts/check-server.mjs",
    "verify-contract": "node scripts/verify-contract.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
    "debug:stream": "node scripts/debug-stream.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
